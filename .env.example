# Copy to .env.local and fill in. Restart `npm run dev` after changing.
# In production these are set in .github/workflows/firebase-hosting-*.yml (both values are public by design).

# Supabase — Project Settings → API. Both are safe in the browser;
# never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GIF search — free key from https://developers.giphy.com/dashboard/ (create an "API" app).
# Optional: it can also be pasted in Settings → GIF search.
VITE_GIPHY_API_KEY=
